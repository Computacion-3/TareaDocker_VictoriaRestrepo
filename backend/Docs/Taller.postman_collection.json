      "name": "Espacios",
      "item": [
        {
          "name": "CREATE ESPACIO",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 or 201\", function () {\r",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);\r",
                  "});\r",
                  "\r",
                  "const jsonData = pm.response.json();\r",
                  "\r",
                  "pm.environment.set(\"espacioId\", jsonData.id);\r",
                  "\r",
                  "pm.test(\"Espacio creado correctamente\", function () {\r",
                  "    pm.expect(jsonData.name).to.eql(\"Gym Principal\");\r",
                  "    pm.expect(jsonData.capacity).to.eql(100);\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"name\": \"Gym Principal\",\r\n    \"type\": \"Crossfit\",\r\n    \"disponibility\": true,\r\n    \"capacity\": 100\r\n}",
